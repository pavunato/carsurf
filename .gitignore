# Theos build output — regenerated by `make`, never hand-edited.
.theos/
*/.theos/

# Built packages. Attach these to GitHub Releases instead of committing them;
# a committed .deb only ever represents one moment and goes stale immediately.
packages/*.deb

# macOS
.DS_Store

# Local Claude Code project settings — machine-specific permission grants,
# not part of the project itself.
.claude/

# Editor/IDE
.vscode/
.idea/
*.swp

# Scratch/debug output that sometimes lands in the repo root during a
# debugging session (screen recordings, ad-hoc screenshots).
*.mov
Main-VideoStream-*.png

# fnm (node version manager) per-shell temp file
.fnm_multishells

# Machine output from device-audit.sh — megabytes per run, findings already
# captured in docs/TODO.md.
docs/audits/
diagnostics/
reference/
